# Portable Linux/dev-container aliases (no macOS-specific bits)

# Route `git` through `gt` (Graphite) when available — keeps oh-my-zsh git
# plugin aliases (gst, gpsup, gd, gco, gcb, gpf, etc) working while preserving
# Graphite's stack metadata. Zsh expands aliases recursively, so any alias
# whose expansion starts with `git` will pick up the `gt` routing transparently.
# Use `command git ...` if you ever need the raw git binary.
command -v gt >/dev/null 2>&1 && alias git='gt'

# history/grep
alias hg='history | grep'
alias g='grep'

# editor
alias v='vim'

# parent-dir navigation
alias u1='cd ..'
alias u2='cd ../..'
alias u3='cd ../../..'
alias u4='cd ../../../..'
alias u5='cd ../../../../..'

# kubectl shortcuts
alias kl="kubectl logs"
alias kgp="kubectl get pods"
alias kgs="kubectl get services"
alias kdp="kubectl describe pod"
alias kds="kubectl describe service"
alias kdi="kubectl describe ingress"
alias kgi="kubectl get ingress"
alias kdelp="kubectl delete pod"
alias kc="kubectl config"
